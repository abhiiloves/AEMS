# Never commit the real .env file. Rotate any key that ever leaks
# (this project's predecessor had its service-role key exposed in a
# shared zip — see project notes).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Session policy (minutes)
SESSION_IDLE_TIMEOUT_ADMIN=5
SESSION_IDLE_TIMEOUT_USER=240

# SMTP for OTP emails + email automation
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@yourcompany.com
